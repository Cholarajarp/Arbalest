# Arbalest Environment Configuration
# Copy this file to .env and fill in your values.

# ─── AI Provider Setup ───────────────────────────────────────────────
# Arbalest runs on Nebius Token Factory, powered by NVIDIA Nemotron models.
ARBALEST_PROVIDER=nebius
NEBIUS_API_KEY=your-nebius-api-key

# Optional: Override the default model
# ARBALEST_MODEL=<nemotron-model-id>

# ─── Live Threat Intel (optional) ────────────────────────────────────
# Enables live CVE/advisory lookups via the Tavily Search API during the
# THREAT RAG phase (https://tavily.com — free tier: 1,000 credits/month).
# Without a key, Arbalest falls back to the local intel corpus only.
# TAVILY_API_KEY=tvly-your-key-here

# ─── Verification sandbox ─────────────────────────────────────────────
# Nebius Token Factory Sandboxes (beta): isolated microVM per run, offline.
# Request access: https://tokenfactory.nebius.com/sandboxes/about
# Find your project id in the Token Factory console. Uses NEBIUS_API_KEY above.
# Leave this commented until you have a real id: setting it switches the
# default sandbox from local Docker to Nebius.
# NEBIUS_PROJECT_ID=your-project-id

# auto (default): Nebius Sandboxes when NEBIUS_PROJECT_ID is set, else local Docker.
# Force one with: nebius | docker
# ARBALEST_SANDBOX_BACKEND=auto

# Prove it works and is offline before a demo:  arbalest sandbox-check

# Local Docker backend only: 'staging' lets local runs use floating image tags
# instead of digest-pinned images.
ARBALEST_ENVIRONMENT=staging

# ─── Deterministic scanners and local state ──────────────────────────
# Optional Semgrep ruleset. Keep unset to disable the optional Semgrep phase.
# Use an organization-reviewed local path for reproducible production scans.
# ARBALEST_SEMGREP_CONFIG=./security/semgrep.yml

# Optional override; defaults to <scanned-repository>/.arbalest/memory.
# ARBALEST_MEMORY_PATH=C:/secure/arbalest-memory

# Required for MCP: semicolon-separated roots on Windows. Access is denied
# when this is unset. The unsafe unrestricted escape hatch is intentionally
# omitted from this production-oriented example.
# ARBALEST_MCP_ALLOWED_ROOTS=C:/workspaces

# Model-SAST analyzes bounded batches and reports the scan incomplete if this
# total character budget omits eligible source. Allowed range: 40000-2000000.
# ARBALEST_SAST_MAX_TOTAL_CHARS=400000

# ─── Other providers (choose one) ────────────────────────────────────
# Run `arbalest providers` to see every option and whether it is ready.
# Each provider reads only its own key; there is no cross-vendor fallback.
# Verification uses Nebius Sandboxes when NEBIUS_PROJECT_ID is set, otherwise
# local Docker, whichever model provider you pick.
#
# Use an existing subscription (no API key; uses the official CLI's sign-in):
# ARBALEST_PROVIDER=claude-cli   # requires `claude` on PATH, signed in
# ARBALEST_PROVIDER=codex-cli    # requires `codex` on PATH, signed in
#
# API presets (set ARBALEST_PROVIDER=<id>, the key, and ARBALEST_MODEL):
#   google      GEMINI_API_KEY (or GOOGLE_AI_API_KEY)
#   mistral     MISTRAL_API_KEY
#   deepseek    DEEPSEEK_API_KEY
#   xai         XAI_API_KEY
#   groq        GROQ_API_KEY
#   together    TOGETHER_API_KEY
#   fireworks   FIREWORKS_API_KEY
#   cerebras    CEREBRAS_API_KEY
#   openrouter  OPENROUTER_API_KEY
#   vercel      VERCEL_AI_GATEWAY_API_KEY
#   ollama      (keyless, http://127.0.0.1:11434/v1/; override OLLAMA_BASE_URL)
#   lmstudio    (keyless, http://127.0.0.1:1234/v1/; override LMSTUDIO_BASE_URL)
#
# Named endpoints without code changes: create arbalest.providers.json
# (see configs/providers.json.example). Provider id `my-gateway` reads
# MY_GATEWAY_API_KEY. Point elsewhere with ARBALEST_PROVIDERS_FILE.
#
# Native OpenAI Responses API:
# ARBALEST_PROVIDER=openai
# OPENAI_API_KEY=your-openai-api-key
# ARBALEST_MODEL=<model-id-from-arbalest-models>
# OPENAI_BASE_URL=https://api.openai.com/v1/  # optional compatible gateway

# Native Anthropic Messages API:
# ARBALEST_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-anthropic-api-key
# ARBALEST_MODEL=<claude-model-id>
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/  # optional compatible gateway

# Custom OpenAI-compatible Chat Completions (vLLM, Ollama, LM Studio, gateways):
# ARBALEST_PROVIDER=custom
# AI_BASE_URL=http://127.0.0.1:11434/v1/
# AI_API_KEY=optional-endpoint-key
# ARBALEST_MODEL=<served-model-id>
# Same endpoint but Responses API: ARBALEST_PROVIDER=custom-responses

# Custom Anthropic Messages-compatible endpoint:
# ARBALEST_PROVIDER=custom-anthropic
# AI_ANTHROPIC_BASE_URL=https://gateway.example.com/v1/
# AI_ANTHROPIC_API_KEY=your-gateway-key
# ARBALEST_MODEL=<model-id>

# Per-role model routing (optional; ids from `arbalest models`).
# Review code with a strong model while cheaper calls use a fast one;
# unset roles use the global ARBALEST_MODEL:
# ARBALEST_MODEL_SAST=<strong-reviewer-id>
# ARBALEST_MODEL_RAG=<fast-summarizer-id>
# ARBALEST_MODEL_HYPOTHESES=<fast-summarizer-id>
